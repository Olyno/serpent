{
    "name": "Vyper",
    "scopeName": "source.vyper",
    "fileTypes": ["vy", "vyi"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#imports" },
        { "include": "#definitions" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#special-vars" },
        { "include": "#constants" },
        { "include": "#types" },
        { "include": "#numbers" },
        { "include": "#operators" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.vyper",
                    "match": "#.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.vyper",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        { "name": "constant.character.escape.vyper", "match": "\\\\." }
                    ]
                },
                {
                    "name": "string.quoted.single.vyper",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        { "name": "constant.character.escape.vyper", "match": "\\\\." }
                    ]
                }
            ]
        },
        "imports": {
            "patterns": [
                {
                    "name": "keyword.control.import.vyper",
                    "match": "\\b(import|from|as|uses|implements|initializes|exports)\\b"
                },
                {
                    "name": "entity.name.namespace.vyper",
                    "match": "(?<=import\\s+)([a-zA-Z_]\\w*)"
                }
            ]
        },
        "definitions": {
            "patterns": [
                {
                    "name": "meta.function.vyper",
                    "begin": "(@[a-zA-Z_]\\w*\\s*\\n)*\\s*\\b(def)\\b",
                    "end": "(?=^\\S)",
                    "beginCaptures": {
                        "2": { "name": "keyword.control.vyper" }
                    },
                    "patterns": [
                        {
                            "name": "entity.name.function.vyper",
                            "match": "\\b([a-zA-Z_]\\w*)\\s*\\("
                        },
                        { "include": "#parameters" },
                        { "include": "#return-type" },
                        { "include": "#type-annotations" },
                        { "include": "#keywords" },
                        { "include": "#builtins" },
                        { "include": "#special-vars" },
                        { "include": "#constants" },
                        { "include": "#types" },
                        { "include": "#numbers" },
                        { "include": "#strings" },
                        { "include": "#comments" },
                        { "include": "#member-access" },
                        { "include": "#operators" }
                    ]
                },
                {
                    "name": "meta.struct.vyper",
                    "begin": "\\b(struct)\\b",
                    "end": "(?=^\\S)",
                    "beginCaptures": {
                        "1": { "name": "storage.type.vyper" }
                    },
                    "patterns": [
                        {
                            "name": "entity.name.type.vyper",
                            "match": "\\b([a-zA-Z_]\\w*)\\b"
                        },
                        { "include": "#type-annotations" }
                    ]
                },
                {
                    "name": "meta.enum.vyper",
                    "begin": "\\b(enum)\\b",
                    "end": "(?=^\\S)",
                    "beginCaptures": {
                        "1": { "name": "storage.type.vyper" }
                    },
                    "patterns": [
                        {
                            "name": "entity.name.type.vyper",
                            "match": "\\b([a-zA-Z_]\\w*)\\b"
                        }
                    ]
                },
                {
                    "name": "meta.event.vyper",
                    "begin": "\\b(event)\\b",
                    "end": "(?=^\\S)",
                    "beginCaptures": {
                        "1": { "name": "storage.type.vyper" }
                    },
                    "patterns": [
                        {
                            "name": "entity.name.type.vyper",
                            "match": "\\b([a-zA-Z_]\\w*)\\b"
                        },
                        { "include": "#type-annotations" },
                        {
                            "name": "storage.modifier.vyper",
                            "match": "\\b(indexed)\\b"
                        }
                    ]
                },
                {
                    "name": "meta.interface.vyper",
                    "begin": "\\b(interface)\\b",
                    "end": "(?=^\\S)",
                    "beginCaptures": {
                        "1": { "name": "storage.type.vyper" }
                    },
                    "patterns": [
                        {
                            "name": "entity.name.type.vyper",
                            "match": "\\b([a-zA-Z_]\\w*)\\b"
                        }
                    ]
                },
                {
                    "name": "meta.flag.vyper",
                    "begin": "\\b(flag)\\b",
                    "end": "(?=^\\S)",
                    "beginCaptures": {
                        "1": { "name": "storage.type.vyper" }
                    },
                    "patterns": [
                        {
                            "name": "entity.name.type.vyper",
                            "match": "\\b([a-zA-Z_]\\w*)\\b"
                        }
                    ]
                }
            ]
        },
        "parameters": {
            "patterns": [
                {
                    "name": "variable.parameter.vyper",
                    "match": "\\b([a-zA-Z_]\\w*)\\s*(?=[:\\),])"
                }
            ]
        },
        "return-type": {
            "patterns": [
                {
                    "name": "storage.type.vyper",
                    "match": "->"
                }
            ]
        },
        "type-annotations": {
            "patterns": [
                {
                    "match": ":\\s*\\b(public|constant|immutable|transient)\\b",
                    "captures": {
                        "1": { "name": "storage.modifier.vyper" }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.vyper",
                    "match": "\\b(def|if|elif|else|for|return|raise|assert|pass|break|continue|in|and|or|not|range|log)\\b"
                },
                {
                    "name": "storage.type.vyper",
                    "match": "\\b(struct|enum|flag|event|interface)\\b"
                },
                {
                    "name": "storage.modifier.vyper",
                    "match": "\\b(public|constant|immutable|indexed|nonpayable|nonreentrant|transient|payable|external|internal)\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.vyper",
                    "match": "\\b(empty|convert|slice|concat|len|keccak256|sha256|ecrecover|ecadd|ecmul|extract32|uint2str|as_wei_value|as_unitless_number|create_minimal_proxy_to|create_copy_of|create_from_blueprint|raw_call|raw_log|raw_revert|raw_create|selfdestruct|send|shift|abs|ceil|epsilon|floor|max|max_value|min|min_value|pow_mod256|sqrt|isqrt|uint256_addmod|uint256_mulmod|unsafe_add|unsafe_sub|unsafe_mul|unsafe_div|print|abi_decode|abi_encode|method_id|clear|pop|append)\\b"
                }
            ]
        },
        "special-vars": {
            "patterns": [
                {
                    "name": "variable.language.vyper",
                    "match": "\\b(self|msg|block|tx|chain)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.vyper",
                    "match": "\\b(True|False|None|max_int128|min_int128|max_uint256|max_decimal|min_decimal|zero_address|empty_bytes32|zero_wei)\\b"
                },
                {
                    "name": "constant.numeric.vyper",
                    "match": "\\b(wei|kwei|babbage|shannon|finney|szabo|gwei|ada|lovelace|mwei|twei|pwei|ether)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.vyper",
                    "match": "\\b(bool|address|decimal|String|Bytes|HashMap|DynArray|uint256|int128|int256|uint8|uint16|uint32|uint64|uint128|bytes32|bytes4|bytes8|bytes16|bytes64)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.vyper",
                    "match": "\\b0x[0-9a-fA-F_]+\\b"
                },
                {
                    "name": "constant.numeric.float.vyper",
                    "match": "\\b[0-9][0-9_]*\\.[0-9_]+\\b"
                },
                {
                    "name": "constant.numeric.integer.vyper",
                    "match": "\\b[0-9][0-9_]*\\b"
                }
            ]
        },
        "member-access": {
            "patterns": [
                {
                    "name": "punctuation.accessor.vyper",
                    "match": "\\."
                },
                {
                    "name": "variable.other.member.vyper",
                    "match": "(?<=\\.)\\s*([a-zA-Z_]\\w*)"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.vyper",
                    "match": "=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|\\*\\*="
                },
                {
                    "name": "keyword.operator.comparison.vyper",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.arithmetic.vyper",
                    "match": "\\+|-|\\*|/|%|\\*\\*"
                },
                {
                    "name": "keyword.operator.bitwise.vyper",
                    "match": "&|\\||\\^|~|<<|>>"
                },
                {
                    "name": "punctuation.separator.vyper",
                    "match": ",|:"
                },
                {
                    "name": "punctuation.section.vyper",
                    "match": "\\(|\\)|\\[|\\]"
                }
            ]
        }
    }
}
