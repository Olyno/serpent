{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Vyper",
    "scopeName": "source.vyper",
    "fileTypes": ["vy", "vyi"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#imports" },
        { "include": "#decorators" },
        { "include": "#function-def" },
        { "include": "#interface-def" },
        { "include": "#struct-def" },
        { "include": "#event-def" },
        { "include": "#enum-def" },
        { "include": "#flag-def" },
        { "include": "#variable-def" },
        { "include": "#constant-def" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#special-vars" },
        { "include": "#constants" },
        { "include": "#types" },
        { "include": "#numbers" },
        { "include": "#member-access" },
        { "include": "#operators" },
        { "include": "#brackets" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.vyper",
                    "match": "#.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.vyper",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        { "name": "constant.character.escape.vyper", "match": "\\\\." }
                    ]
                },
                {
                    "name": "string.quoted.single.vyper",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        { "name": "constant.character.escape.vyper", "match": "\\\\." }
                    ]
                }
            ]
        },
        "imports": {
            "patterns": [
                {
                    "name": "keyword.control.import.vyper",
                    "match": "\\b(import|from|as|uses|implements|initializes|exports)\\b"
                }
            ]
        },
        "decorators": {
            "patterns": [
                {
                    "name": "storage.modifier.decorator.vyper entity.name.function.decorator.vyper",
                    "match": "@[a-zA-Z_]\\w*"
                }
            ]
        },
        "function-def": {
            "name": "meta.function.vyper",
            "begin": "\\b(def)\\s+([a-zA-Z_]\\w*)\\s*(\\()",
            "end": "(?=^\\s*\\S|^\\s*$)",
            "beginCaptures": {
                "1": { "name": "keyword.function.vyper keyword.control.vyper" },
                "2": { "name": "entity.name.function.vyper" },
                "3": { "name": "punctuation.section.parens.begin.vyper" }
            },
            "patterns": [
                { "include": "#parameters" },
                { "include": "#return-type" },
                { "include": "#type-annotations" },
                { "include": "$self" }
            ]
        },
        "interface-def": {
            "name": "meta.interface.vyper",
            "begin": "\\b(interface)\\s+([a-zA-Z_]\\w*)",
            "end": "(?=^\\s*\\S|^\\s*$)",
            "beginCaptures": {
                "1": { "name": "keyword.storage.type.vyper storage.type.vyper" },
                "2": { "name": "entity.name.type.vyper" }
            },
            "patterns": [
                { "include": "#function-def" }
            ]
        },
        "struct-def": {
            "name": "meta.struct.vyper",
            "begin": "\\b(struct)\\s+([a-zA-Z_]\\w*)",
            "end": "(?=^\\s*\\S|^\\s*$)",
            "beginCaptures": {
                "1": { "name": "keyword.storage.type.vyper storage.type.vyper" },
                "2": { "name": "entity.name.type.vyper" }
            },
            "patterns": [
                { "include": "#type-annotations" },
                { "include": "$self" }
            ]
        },
        "event-def": {
            "name": "meta.event.vyper",
            "begin": "\\b(event)\\s+([a-zA-Z_]\\w*)",
            "end": "(?=^\\s*\\S|^\\s*$)",
            "beginCaptures": {
                "1": { "name": "keyword.storage.type.vyper storage.type.vyper" },
                "2": { "name": "entity.name.type.vyper" }
            },
            "patterns": [
                { "include": "#type-annotations" },
                {
                    "name": "storage.modifier.vyper",
                    "match": "\\bindexed\\b"
                },
                { "include": "$self" }
            ]
        },
        "enum-def": {
            "name": "meta.enum.vyper",
            "begin": "\\b(enum)\\s+([a-zA-Z_]\\w*)",
            "end": "(?=^\\s*\\S|^\\s*$)",
            "beginCaptures": {
                "1": { "name": "storage.type.vyper" },
                "2": { "name": "entity.name.type.vyper" }
            },
            "patterns": []
        },
        "flag-def": {
            "name": "meta.flag.vyper",
            "begin": "\\b(flag)\\s+([a-zA-Z_]\\w*)",
            "end": "(?=^\\s*\\S|^\\s*$)",
            "beginCaptures": {
                "1": { "name": "storage.type.vyper" },
                "2": { "name": "entity.name.type.vyper" }
            },
            "patterns": []
        },
        "variable-def": {
            "name": "meta.variable.vyper",
            "match": "([a-zA-Z_]\\w*)\\s*:\\s*(public\\s+)?(\\()?([a-zA-Z_]\\w*)\\)?\\s*(=\\s*[^\\n]+)?",
            "captures": {
                "1": { "name": "variable.other.vyper" },
                "2": { "name": "storage.modifier.vyper" },
                "3": { "name": "punctuation.section.parens.vyper" },
                "4": { "name": "support.type.primitive.vyper support.type.vyper" },
                "5": { "name": "keyword.operator.assignment.vyper" }
            }
        },
        "constant-def": {
            "name": "meta.constant.vyper",
            "match": "([A-Z_][A-Z0-9_]*)\\s*:\\s*(constant|immutable)\\s*\\(([a-zA-Z_]\\w*)\\)\\s*=\\s*(.+)",
            "captures": {
                "1": { "name": "variable.other.constant.vyper" },
                "2": { "name": "storage.modifier.vyper" },
                "3": { "name": "support.type.primitive.vyper support.type.vyper" }
            }
        },
        "parameters": {
            "patterns": [
                {
                    "name": "variable.parameter.vyper",
                    "match": "([a-zA-Z_]\\w*)\\s*:\\s*"
                },
                {
                    "name": "punctuation.separator.parameter.vyper",
                    "match": ","
                },
                {
                    "name": "punctuation.section.parens.end.vyper",
                    "match": "\\)"
                }
            ]
        },
        "return-type": {
            "match": "->\\s*([a-zA-Z_]\\w*)",
            "captures": {
                "0": { "name": "punctuation.separator.arrow.vyper keyword.operator.arrow.vyper" },
                "1": { "name": "support.type.primitive.vyper support.type.vyper" }
            }
        },
        "type-annotations": {
            "match": ":\\s*(public|constant|immutable|transient)\\b",
            "captures": {
                "1": { "name": "storage.modifier.vyper" }
            }
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.conditional.vyper keyword.control.vyper",
                    "match": "\\b(if|elif|else)\\b"
                },
                {
                    "name": "keyword.control.repeat.vyper keyword.control.vyper",
                    "match": "\\b(for|range)\\b"
                },
                {
                    "name": "keyword.control.return.vyper keyword.control.vyper",
                    "match": "\\b(return)\\b"
                },
                {
                    "name": "keyword.control.exception.vyper keyword.control.vyper",
                    "match": "\\b(raise|assert)\\b"
                },
                {
                    "name": "keyword.control.import.vyper keyword.control.vyper",
                    "match": "\\b(import|from|as|uses|implements|initializes|exports)\\b"
                },
                {
                    "name": "keyword.control.vyper",
                    "match": "\\b(def|in|pass|break|continue|not|and|or|log|is)\\b"
                },
                {
                    "name": "keyword.storage.type.vyper storage.type.vyper",
                    "match": "\\b(struct|enum|flag|event|interface)\\b"
                },
                {
                    "name": "storage.modifier.vyper",
                    "match": "\\b(public|constant|immutable|indexed|nonpayable|nonreentrant|transient|payable|external|internal)\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.vyper support.function.vyper",
                    "match": "\\b(empty|convert|slice|concat|len|keccak256|sha256|ecrecover|ecadd|ecmul|extract32|uint2str|as_wei_value|as_unitless_number|create_minimal_proxy_to|create_copy_of|create_from_blueprint|raw_call|raw_log|raw_revert|raw_create|selfdestruct|send|shift|abs|ceil|epsilon|floor|max|max_value|min|min_value|pow_mod256|sqrt|isqrt|uint256_addmod|uint256_mulmod|unsafe_add|unsafe_sub|unsafe_mul|unsafe_div|print|abi_decode|abi_encode|method_id|clear|pop|append)\\b"
                }
            ]
        },
        "special-vars": {
            "patterns": [
                {
                    "name": "variable.language.vyper",
                    "match": "\\b(self|msg|block|tx|chain)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.vyper",
                    "match": "\\b(True|False|None)\\b"
                },
                {
                    "name": "constant.language.vyper",
                    "match": "\\b(max_int128|min_int128|max_uint256|max_decimal|min_decimal|zero_address|empty_bytes32|zero_wei)\\b"
                },
                {
                    "name": "constant.numeric.unit.vyper",
                    "match": "\\b(wei|kwei|babbage|shannon|finney|szabo|gwei|ada|lovelace|mwei|twei|pwei|ether)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.vyper",
                    "match": "\\b(bool|address|decimal|String|Bytes|HashMap|DynArray|uint256|int128|int256|uint8|uint16|uint32|uint64|uint128|bytes32|bytes4|bytes8|bytes16|bytes64)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.vyper",
                    "match": "\\b0x[0-9a-fA-F_]+\\b"
                },
                {
                    "name": "constant.numeric.float.vyper",
                    "match": "\\b[0-9][0-9_]*\\.[0-9_]+\\b"
                },
                {
                    "name": "constant.numeric.integer.vyper",
                    "match": "\\b[0-9][0-9_]*\\b"
                }
            ]
        },
        "member-access": {
            "patterns": [
                {
                    "name": "punctuation.accessor.vyper",
                    "match": "\\."
                },
                {
                    "name": "variable.other.member.vyper",
                    "match": "(?<=\\.)[a-zA-Z_]\\w*"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.augmented.vyper",
                    "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|\\*\\*="
                },
                {
                    "name": "keyword.operator.comparison.vyper",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.arithmetic.vyper",
                    "match": "\\+|-|\\*(?!\\*)|/(?!/)|%"
                },
                {
                    "name": "keyword.operator.arithmetic.vyper",
                    "match": "\\*\\*"
                },
                {
                    "name": "keyword.operator.bitwise.vyper",
                    "match": "&(?!&)|\\|(?!\\|)|\\^|~|<<|>>"
                },
                {
                    "name": "keyword.operator.logical.vyper",
                    "match": "\\b(and|or|not)\\b"
                },
                {
                    "name": "punctuation.separator.colon.vyper",
                    "match": ":"
                },
                {
                    "name": "keyword.operator.assignment.vyper",
                    "match": "="
                },
                {
                    "name": "punctuation.separator.comma.vyper",
                    "match": ","
                }
            ]
        },
        "brackets": {
            "patterns": [
                {
                    "name": "punctuation.section.parens.vyper",
                    "match": "\\(|\\)"
                },
                {
                    "name": "punctuation.section.brackets.vyper",
                    "match": "\\[|\\]"
                }
            ]
        }
    }
}
