{
    "name": "serpent-vscode",
    "displayName": "Serpent - Vyper Language Support",
    "description": "Vyper language support for Visual Studio Code — LSP, snippets, syntax highlighting, compilation",
    "version": "0.1.0",
    "license": "MIT",
    "publisher": "serpent",
    "icon": "images/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/nousresearch/serpent"
    },
    "bugs": {
        "url": "https://github.com/nousresearch/serpent/issues"
    },
    "engines": {
        "vscode": "^1.87.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Linters"
    ],
    "keywords": [
        "vyper",
        "ethereum",
        "blockchain",
        "compiler",
        "security",
        "smart-contract"
    ],
    "type": "module",
    "activationEvents": [
        "onLanguage:vyper"
    ],
    "main": "./dist/extension.cjs",
    "browser": "./dist/web/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "vyper",
                "aliases": [
                    "Vyper",
                    "vyper"
                ],
                "extensions": [
                    ".vy",
                    ".vyi"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "images/icon.png",
                    "dark": "images/icon.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "vyper",
                "scopeName": "source.vyper",
                "path": "./syntaxes/vyper.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "vyper",
                "path": "./snippets/expr_builtins.json"
            },
            {
                "language": "vyper",
                "path": "./snippets/stmt_builtins.json"
            },
            {
                "language": "vyper",
                "path": "./snippets/expressions.json"
            },
            {
                "language": "vyper",
                "path": "./snippets/statements.json"
            },
            {
                "language": "vyper",
                "path": "./snippets/module.json"
            },
            {
                "language": "vyper",
                "path": "./snippets/other.json"
            },
            {
                "language": "vyper",
                "path": "./snippets/types.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Serpent — Vyper",
            "properties": {
                "serpent.lsp.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable/disable the Language Server Protocol (completion, diagnostics, navigation)."
                },
                "serpent.compile.onSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically compile the contract on save."
                },
                "serpent.compile.command": {
                    "type": "string",
                    "default": "vyper",
                    "description": "Shell command to invoke the Vyper compiler (e.g. 'vyper', 'python -m vyper')."
                },
                "serpent.lsp.serverPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the serpent-lsp executable. Leave empty to use 'serpent-lsp' from PATH.",
                    "scope": "machine"
                },
                "serpent.python.interpreter": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Path to the Python interpreter to use. Leave empty for auto-detection.",
                    "scope": "machine"
                }
            }
        },
        "commands": [
            {
                "command": "serpent.compile",
                "title": "Serpent: Compile Vyper Contract",
                "category": "Serpent"
            },
            {
                "command": "serpent.restartLsp",
                "title": "Serpent: Restart LSP Server",
                "category": "Serpent"
            },
            {
                "command": "serpent.installFormatter",
                "title": "Serpent: Install mamushi Formatter",
                "category": "Serpent"
            }
        ]
    },
    "scripts": {
        "compile": "node esbuild.config.mjs",
        "watch": "node esbuild.config.mjs --watch",
        "lint": "biome lint src/",
        "format": "biome format --write src/",
        "check": "biome check src/",
        "package": "vsce package",
        "test": "echo 'Tests à implémenter'"
    },
    "dependencies": {
        "@olyno/tree-sitter-vyper": "file:../../../_ref_tree_sitter_vyper/olyno-tree-sitter-vyper-0.1.0.tgz",
        "vscode-languageclient": "^9.0.1",
        "web-tree-sitter": "^0.26.9"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.16",
        "@types/node": "^25.9.1",
        "@types/vscode": "1.87.0",
        "@vscode/test-electron": "^2.4.1",
        "@vscode/test-web": "^0.0.62",
        "esbuild": "^0.24.0",
        "typescript": "^5.6.0"
    },
    "allowScripts": {
        "esbuild@0.24.2": true
    }
}
