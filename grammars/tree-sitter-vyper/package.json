{
  "name": "tree-sitter-vyper",
  "version": "1.0.0",
  "description": "Tree-sitter grammar for the Vyper smart contract language",
  "main": "bindings/node",
  "scripts": {
    "build": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/serpent-lang/tree-sitter-vyper"
  },
  "keywords": [
    "tree-sitter",
    "vyper",
    "grammar",
    "parser"
  ],
  "author": "Serpent Team",
  "license": "MIT",
  "tree-sitter": [
    {
      "scope": "source.vyper",
      "file-types": [
        "vy",
        "vyi"
      ],
      "injection-regex": "^vyper$"
    }
  ],
  "devDependencies": {
    "tree-sitter-cli": "^0.22.0"
  }
}
